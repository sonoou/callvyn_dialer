<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_incoming_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_headsup_card"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Top Section: Avatar + Text Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Avatar with Badge -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/iv_caller_avatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@mipmap/ic_launcher"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/iv_badge_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="bottom|end"
                android:src="@mipmap/ic_launcher"
                android:scaleType="centerInside" />
        </FrameLayout>

        <!-- Header and Subtitle Texts -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Caller Name • Callvyn • 11:06 am"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Incoming call • +91 98765 43210"
                android:textColor="#B0B0B8"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Line: Action Icon Buttons (Right/Center Aligned) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <!-- Red Decline Button -->
        <ImageView
            android:id="@+id/btn_reject_call"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_btn_reject_circle"
            android:src="@drawable/ic_call_end_white"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:contentDescription="Decline" />

        <Space
            android:layout_width="16dp"
            android:layout_height="1dp" />

        <!-- Green Answer Button -->
        <ImageView
            android:id="@+id/btn_answer_call"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_btn_answer_circle"
            android:src="@drawable/ic_call_white"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:contentDescription="Answer" />
    </LinearLayout>
</LinearLayout>
